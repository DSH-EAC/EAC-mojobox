{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "version", "category", "source", "author", "license", "sha256"],
  "properties": {
    "format": { "const": "eac-feature-pack-v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "category": { "enum": ["function", "appearance", "workflow"] },
    "source": { "type": "string", "format": "uri", "pattern": "^https://" },
    "author": { "type": "string", "minLength": 1, "maxLength": 128 },
    "license": { "type": "string", "minLength": 1, "maxLength": 64 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["skin", "theme", "ui-skin", "appearance"] },
        "loader": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "source": { "type": "string", "format": "uri", "pattern": "^https://" }
          }
        },
        "skinIds": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "conflicts": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "previews": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "notes": { "type": "string", "maxLength": 1000 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "category": { "const": "appearance" } } },
      "then": { "required": ["appearance"] }
    },
    {
      "if": { "properties": { "category": { "not": { "const": "appearance" } } } },
      "then": { "not": { "required": ["appearance"] } }
    }
  ]
}
